@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">Bartender Application</h1>

    <p class="lead mt-3">
        Welcome to the cocktail ordering system.
    </p>

    <p class="text-muted mb-5">
        Select an option below to get started.
    </p>

    <div class="d-flex justify-content-center gap-3">

        <a asp-controller="CocktailOrders"
           asp-action="Menu"
           class="btn btn-primary btn-lg">
            Order a Cocktail
        </a>

        <a asp-controller="CocktailOrders"
           asp-action="Queue"
           class="btn btn-dark btn-lg">
            Bartender Order Queue
        </a>

    </div>
</div>